GEMINI_API_KEY=your_key_here

# Everything below is optional. Defaults are tuned for a Google AI Pro plan
# ($10/month of API credits on a paid key).

# Monthly budget, in USD. The header meter tracks estimated spend, and new
# interviews are refused once it's reached.
# SPEAKWELL_MONTHLY_BUDGET_USD=10

# Model chains: comma-separated, first is tried first, the rest are fallbacks.
# SPEAKWELL_PLANNER_MODELS=gemini-4-argon,gemini-3.8-flash,gemini-3.5-flash-lite
# SPEAKWELL_GRADER_MODELS=gemini-4-argon,gemini-3.8-flash,gemini-3.5-flash-lite
# SPEAKWELL_DELIVERY_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# SPEAKWELL_INTERVIEWER_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Intro and your-questions phases use the fast model first:
# SPEAKWELL_INTERVIEWER_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# SPEAKWELL_INTERVIEWER_THINKING=low
# SPEAKWELL_TRANSCRIBE_MODEL=gemini-3.5-transcribe
